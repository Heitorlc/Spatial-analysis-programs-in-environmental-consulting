# ==========================================
# FUNÇÃO DE CONVERSÃO DE COORDENADAS
# ==========================================
converter_coordenada <- function(coord) {
  if(is.na(coord) || coord == "") return(NA_real_)
  
  coord_str <- as.character(coord)
  coord_str <- str_replace_all(coord_str, ",", ".") 
  
  if (str_detect(coord_str, "^-?\\d+\\.?\\d*$")) {
    return(as.numeric(coord_str))
  }
  
  numeros <- as.numeric(unlist(str_extract_all(coord_str, "\\d+\\.?\\d*")))
  
  if (length(numeros) > 0) {
    graus <- numeros[1]
    minutos <- ifelse(length(numeros) >= 2, numeros[2], 0)
    segundos <- ifelse(length(numeros) >= 3, numeros[3], 0)
    
    decimal <- graus + (minutos / 60) + (segundos / 3600)
    
    if (str_detect(str_to_upper(coord_str), "S|W|O") || str_detect(coord_str, "^-")) {
      decimal <- decimal * -1
    }
    return(decimal)
  }
  return(NA_real_)
}

