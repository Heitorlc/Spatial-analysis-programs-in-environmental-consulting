  output$dl_shapefile <- downloadHandler(
    filename = function() {
      paste0("inventario_shapefile_", Sys.Date(), ".zip")
    },
    content = function(file) {
      req(resultados())
      df_espacial <- resultados()$dados_arvore %>% filter(!is.na(coord_x) & !is.na(coord_y))
      
      if(nrow(df_espacial) > 0) {
        sf_obj <- st_as_sf(df_espacial, coords = c("coord_x", "coord_y"), crs = 4326)
        
        # Cria uma pasta temporária isolada
        tmpfolder <- file.path(tempdir(), paste0("shp_export_", as.numeric(Sys.time())))
        dir.create(tmpfolder, showWarnings = FALSE)
        
        shape_path <- file.path(tmpfolder, "arvores_inventario.shp")
        suppressWarnings(st_write(sf_obj, dsn = shape_path, driver = "ESRI Shapefile", quiet = TRUE, delete_dsn = TRUE))
        
        # Coleta os arquivos gerados (.shp, .shx, .dbf, .prj, .cpg)
        arquivos_gerados <- list.files(tmpfolder, full.names = TRUE)
        
        if (requireNamespace("zip", quietly = TRUE)) {
          zip::zipr(zipfile = file, files = arquivos_gerados, mode = "cherry-pick")
        } else {
          owd <- setwd(tmpfolder)
          on.exit(setwd(owd))
          zip(zipfile = file, files = list.files("."))
        }
      }
    },
    contentType = "application/zip"
  )
  
