  # --- GRÁFICOS DINÂMICOS PARA ESTRATOS NO DASHBOARD ---
  output$ui_graficos_estratos <- renderUI({
    req(resultados())
    if(rv$metodo != "estratificada") return(NULL)
    
    tagList(
      hr(),
      fluidRow(
        column(6, card(full_screen = TRUE, card_header("Volume Total Amostrado por Estrato (m³)"), card_body(plotlyOutput("grafico_vol_estrato") %>% withSpinner(color="#001a33")))),
        column(6, card(full_screen = TRUE, card_header("Média Volumétrica por Parcela por Estrato (m³)"), card_body(plotlyOutput("grafico_media_estrato") %>% withSpinner(color="#001a33"))))
      )
    )
  })
  
  output$grafico_vol_estrato <- renderPlotly({
    req(resultados())
    if(is.null(resultados()$vol_parcelas)) return(NULL)
    
