# ==========================================
# SERVER
# ==========================================
server <- function(input, output, session) {
  
  # --- TIMEOUT OBSERVER ---
  observeEvent(input$inactivity_timeout, {
    showModal(modalDialog(
      title = "Sessão Expirada por Inatividade",
      "Sua sessão foi desconectada para economizar os recursos do servidor após 5 minutos sem uso. Por favor, recarregue a página (F5) para iniciar uma nova análise.",
      easyClose = FALSE, footer = NULL
    ))
    session$close() 
  })
  
  # REACTIVE STORAGE
  ada_reativa <- reactiveVal(NULL)
  resultados_relatorio <- reactiveVal(data.frame())
  conflitos_geo <- reactiveVal(list())
  catalogo_wfs <- reactiveVal(list())
  laudo_pronto <- reactiveVal(FALSE)
  laudo_raw_markdown <- reactiveVal("")
  
  # INITIAL STATE FOR PREVIEW
  texto_minuta <- reactiveVal(HTML("<p style='color: gray; text-align: center; margin-top: 50px;'>Preencha os dados opcionais (se desejar), rode a análise espacial na primeira aba e clique em <b>'Gerar Minuta do Laudo'</b> para visualizar o documento preliminar.</p>"))
  output$preview_laudo <- renderUI({ texto_minuta() })
  
  # DYNAMIC PDF BUTTON RENDERER
  output$ui_download_pdf_btn <- renderUI({
    if(isTRUE(laudo_pronto())) {
      downloadButton("baixar_pdf_laudo", "Baixar Laudo PDF", class = "btn-danger btn-sm", icon = icon("file-pdf"))
    } else {
      actionButton("baixar_pdf_disabled", "Baixar Laudo PDF", class = "btn-secondary btn-sm", disabled = TRUE, icon = icon("file-pdf"))
    }
  })
  
  status_wfs <- reactiveVal(tags$p("⏳ Carregando catálogo do servidor...", style = "color: orange; font-size: 0.9em; font-weight: bold;"))
  output$wfs_status_ui <- renderUI({ status_wfs() })
  
  # --- INITIAL CONNECTIONS TO SERVER ---
  observe({
    tryCatch({
      req_cap <- GET(paste0(WFS_BASE_URL, "?service=wfs&version=2.0.0&request=GetCapabilities"))
      xml_doc <- read_xml(content(req_cap, "text"))
      ns <- xml_ns(xml_doc)
      
      feature_types <- xml_find_all(xml_doc, ".//wfs:FeatureType", ns)
      
      l_names  <- xml_text(xml_find_first(feature_types, ".//wfs:Name", ns))
      l_titles <- xml_text(xml_find_first(feature_types, ".//wfs:Title", ns))
      l_titles <- ifelse(is.na(l_titles) | l_titles == "", l_names, l_titles)
      
      choices_vec <- setNames(l_names, l_titles)
      choices_vec <- choices_vec[order(names(choices_vec))]
      
      catalogo_wfs(choices_vec)
      
      updatePickerInput(session, "camadas_selecionadas", 
                        choices = choices_vec, 
                        options = pickerOptions(noneSelectedText = "Selecione as camadas..."))
      
      status_wfs(tags$p("✅ Conectado ao IDE-SISEMA (WFS)", style = "color: #18bc9c; font-size: 0.9em; font-weight: bold;"))
      
    }, error = function(e) {
      status_wfs(tags$p("❌ Erro ao conectar no servidor do Governo.", style = "color: red; font-size: 0.9em; font-weight: bold;"))
    })
  })
  
  # --- ADVANCED BATCH LAYER FILTERING ---
  observeEvent(input$btn_dn217, {
    req(catalogo_wfs())
    c_vec <- catalogo_wfs()
    
    regex_in <- "(?i)(unidade.*conserva[çc][ãa]o|zona.*amortecimento|s[íi]tio.*ramsar|reserva.*biosfera|corredor.*ecol[óo]gico|conflito.*h[íi]drico|cavidade|aeroportu[áa]ria|rio.*preserva[çc][ãa]o|terra.*ind[íi]gena|terra.*quilombola|raio.*restri[çc][ãa]o|patrim[ôo]nio cultural|bens tombados|enquadramento|[áa]rea.*preserva[çc][ãa]o permanente|\\bapp\\b)"
    regex_out <- "(?i)(im[óo]vel|im[óo]veis|lugares registrados|pmsh|pesquisas sobre esp[é]cies|rppn|saberes registrados|\\bzap\\b|\\bzee\\b|pscrmg)"
    
    camadas_alvo <- c_vec[grepl(regex_in, names(c_vec)) | grepl(regex_in, c_vec)]
    camadas_alvo <- camadas_alvo[!(grepl(regex_out, names(camadas_alvo)) | grepl(regex_out, camadas_alvo))]
    
    updatePickerInput(session, "camadas_selecionadas", selected = camadas_alvo)
    showNotification(paste(length(camadas_alvo), "camadas da DN 217 selecionadas!"), type = "message")
  })
  
  # --- RENDER TAB 1 MAP ---
  output$mapa_principal <- renderLeaflet({
    leaflet() %>% 
      addProviderTiles(providers$Esri.WorldImagery, group = "Satélite") %>%
      addProviderTiles(providers$OpenTopoMap, group = "Relevo/Topografia") %>%
      addProviderTiles(providers$CartoDB.Positron, group = "Mapa Minimalista") %>%
      setView(-42.88, -20.75, 13) %>% 
      addDrawToolbar(
        targetGroup = "ada_draw", polylineOptions = FALSE, circleOptions = FALSE,
        markerOptions = FALSE, circleMarkerOptions = FALSE,
        polygonOptions = drawPolygonOptions(shapeOptions = drawShapeOptions(color = "#18bc9c", weight = 3))
      ) %>%
      addLayersControl(baseGroups = c("Satélite", "Relevo/Topografia", "Mapa Minimalista"), options = layersControlOptions(collapsed = TRUE))
  })
  
  # --- UNIVERSAL GEOM SMART ZOOM ---
  aplicar_zoom_inteligente <- function(ada_obj, message = "Área carregada e centralizada no mapa!") {
    bbox <- sf::st_bbox(ada_obj)
    tipo_geom <- as.character(sf::st_geometry_type(ada_obj, by_geometry = FALSE))
    
    proxy <- leafletProxy("mapa_principal") %>% clearGroup("ada_draw")
    
    if(any(grepl("POINT", tipo_geom))) {
      proxy <- proxy %>% addCircleMarkers(data = ada_obj, group = "ada_draw", color = "#f39c12", radius = 8, fillOpacity = 0.8)
    } else if (any(grepl("LINE", tipo_geom))) {
      proxy <- proxy %>% addPolylines(data = ada_obj, group = "ada_draw", color = "#f39c12", weight = 4)
    } else {
      proxy <- proxy %>% addPolygons(data = ada_obj, group = "ada_draw", color = "#f39c12", weight = 3, fillOpacity = 0.3)
    }
    
    if(isTRUE(as.numeric(bbox[["xmin"]]) == as.numeric(bbox[["xmax"]])) && isTRUE(as.numeric(bbox[["ymin"]]) == as.numeric(bbox[["ymax"]]))) {
      proxy %>% setView(lng = as.numeric(bbox[["xmin"]]), lat = as.numeric(bbox[["ymin"]]), zoom = 16)
    } else {
      proxy %>% fitBounds(as.numeric(bbox[["xmin"]]), as.numeric(bbox[["ymin"]]), 
                          as.numeric(bbox[["xmax"]]), as.numeric(bbox[["ymax"]]))
    }
    showNotification(message, type = "message")
  }
  
  # --- SPATIAL INPUT WATCHERS ---
  observeEvent(input$mapa_principal_draw_new_feature, {
    feat <- input$mapa_principal_draw_new_feature
    ada <- geojsonsf::geojson_sf(jsonlite::toJSON(feat, auto_unbox = TRUE, force = TRUE)) %>% sf::st_set_crs(4326) %>% sf::st_make_valid()
    ada_reativa(ada)
  })
  
  observeEvent(input$arquivo_geo, {
    req(input$arquivo_geo)
    ext <- tools::file_ext(input$arquivo_geo$name)
    tryCatch({
      if (tolower(ext) == "zip") {
        temp_dir <- file.path(tempdir(), "upload_shp"); dir.create(temp_dir, showWarnings = FALSE)
        unzip(input$arquivo_geo$datapath, exdir = temp_dir)
        shp_file <- list.files(temp_dir, pattern = "\\.shp$", full.names = TRUE, ignore.case = TRUE)[1]
        ada <- sf::st_read(shp_file, quiet = TRUE)
      } else {
        ada <- sf::st_read(input$arquivo_geo$datapath, quiet = TRUE)
      }
      ada <- ada %>% sf::st_zm(drop = TRUE) %>% sf::st_transform(4326) %>% sf::st_make_valid()
      ada_reativa(ada)
      aplicar_zoom_inteligente(ada)
    }, error = function(e) { showNotification("Erro ao processar o arquivo vetorial.", type = "error") })
  })
  
  observeEvent(input$gerar_coord, {
    req(input$lat_manual, input$lon_manual, input$raio_manual)
    ponto <- sf::st_as_sf(data.frame(x = input$lon_manual, y = input$lat_manual), coords = c("x", "y"), crs = 4326)
    ponto_m <- sf::st_transform(ponto, CRS_METRICO)
    ada <- sf::st_buffer(ponto_m, input$raio_manual) %>% sf::st_transform(4326)
    ada_reativa(ada)
    aplicar_zoom_inteligente(ada, "Buffer gerado e centralizado com sucesso!")
  })
  
  output$baixar_kml <- downloadHandler(filename = function() { paste0("ADA_G5S_", Sys.Date(), ".kml") }, content = function(file) { sf::st_write(ada_reativa(), file, driver = "KML", delete_dsn = TRUE, quiet = TRUE) })
  output$baixar_shp <- downloadHandler(
    filename = function() { paste0("ADA_G5S_Shapefile_", Sys.Date(), ".zip") },
    content = function(file) {
      req(ada_reativa())
      temp_dir <- file.path(tempdir(), "shp_export"); dir.create(temp_dir, showWarnings = FALSE)
      sf::st_write(ada_reativa(), dsn = temp_dir, layer = "ADA_G5S", driver = "ESRI Shapefile", delete_layer = TRUE, quiet = TRUE)
      owd <- setwd(temp_dir); on.exit(setwd(owd))
      utils::zip(zipfile = file, files = list.files(".", pattern = "^ADA_G5S\\.(shp|shx|dbf|prj|cpg)$"))
    }
  )
  
  # --- DIRECT WFS SPATIAL INTERSECTIONS ---
  observeEvent(input$rodar_analise, {
    req(ada_reativa()); req(input$camadas_selecionadas)
    
    withProgress(message = 'Consultando Geoserver Estadual...', value = 0, {
      ada_m <- sf::st_transform(ada_reativa(), 31983)
      if(!is.na(input$raio_buffer) && input$raio_buffer > 0) ada_m <- sf::st_buffer(ada_m, input$raio_buffer)
      
      ada_4326 <- sf::st_transform(ada_m, 4326)
      bbox <- sf::st_bbox(ada_4326)
      bbox_str <- paste(bbox["xmin"], bbox["ymin"], bbox["xmax"], bbox["ymax"], "EPSG:4326", sep=",")
      
      lista_res <- list(); geo_full_list <- list()
      choices_vec <- catalogo_wfs()
      
      for(camada in input$camadas_selecionadas) {
        titulo_amigavel <- names(choices_vec)[choices_vec == camada]
        if(length(titulo_amigavel) == 0) titulo_amigavel <- camada 
        
        incProgress(1/length(input$camadas_selecionadas), detail = titulo_amigavel)
        row_data <- data.frame(Camada = titulo_amigavel, Veredito = "✅ NADA CONSTA", Detalhes = "Área livre.", stringsAsFactors = FALSE)
        
        tryCatch({
          url_req <- URLencode(paste0(
            WFS_BASE_URL, 
            "?service=WFS&version=1.0.0&request=GetFeature&typeName=", camada,
            "&outputFormat=application/json&srsName=EPSG:4326&bbox=", bbox_str
          ))
          
          dados <- sf::st_read(url_req, quiet = TRUE)
          
          if(nrow(dados) > 0) {
            dados_m <- sf::st_transform(dados, 31983) %>% sf::st_make_valid() %>% sf::st_buffer(0)
            inter_idx <- which(sf::st_intersects(dados_m, ada_m, sparse = FALSE))
            
            if(length(inter_idx) > 0) {
              feicoes_conflito <- dados[inter_idx, ]
              
              row_data$Veredito <- "🚨 SOBREPOSIÇÃO"
              row_data$Detalhes <- paste("Interceptou", length(inter_idx), "objeto(s).")
              
              # --- SPECIFIC LOGIC: CAVITY POTENTIAL ---
              if(grepl("(?i)cavidade", titulo_amigavel) || grepl("(?i)cavidade", camada)) {
                col_grau <- grep("(?i)grau_de_po", names(feicoes_conflito), value = TRUE)
                if(length(col_grau) > 0) {
                  graus <- na.omit(unique(feicoes_conflito[[col_grau[1]]]))
                  graus_str <- paste(graus, collapse = ", ")
                  
                  if(length(graus) > 0 && isTRUE(any(grepl("(?i)alto", graus), na.rm = TRUE))) {
                    row_data$Detalhes <- paste0("Interceptou ", length(inter_idx), " feição(ões). Grau de Potencialidade: ", toupper(graus_str), ".")
                  } else if (length(graus) > 0) {
                    row_data$Veredito <- "ℹ️ INFORMAÇÃO"
                    row_data$Detalhes <- paste0("Inserida em polígono contínuo com Grau: ", toupper(graus_str), " (Não compõe critério restritivo da DN 217).")
                  }
                }
              }
              
              popups <- apply(sf::st_drop_geometry(feicoes_conflito), 1, function(r) {
                paste0("<b>Atributos Oficiais:</b><br>", paste0("<b>", names(r), "</b>: ", r, collapse = "<br>"))
              })
              feicoes_conflito$popup_info <- popups
              geo_full_list[[titulo_amigavel]] <- sf::st_transform(feicoes_conflito, 4326)
            }
          }
        }, error = function(e) {
          row_data$Veredito <- "⚠️ FALHA WFS"; row_data$Detalhes = "Erro ao baixar do servidor."
        })
        lista_res[[titulo_amigavel]] <- row_data
      }
      
      # --- POST-PROCESSING: TABLE CONSOLIDATION ONLY (Preserves SF integrity) ---
      
      # 1. Enquadramento de Corpos d'água
      idx_enq <- grep("(?i)enquadramento", names(lista_res))
      if(length(idx_enq) > 0) {
        enq_conflitos <- Filter(function(x) x$Veredito == "🚨 SOBREPOSIÇÃO", lista_res[idx_enq])
        row_enq_final <- data.frame(Camada = "Enquadramento de Corpos D'água (Bacias Hidrográficas)", 
                                    Veredito = ifelse(length(enq_conflitos) > 0, "🚨 SOBREPOSIÇÃO", "✅ NADA CONSTA"), 
                                    Detalhes = ifelse(length(enq_conflitos) > 0, paste("Interceptou", length(enq_conflitos), "bacia(s)."), "Área livre."), 
                                    stringsAsFactors = FALSE)
        lista_res <- lista_res[-idx_enq]
        lista_res[["Enquadramento Consolidado"]] <- row_enq_final
      }
      
      # 2. Áreas de Preservação Permanente (APPs)
      idx_app <- grep("(?i)([áa]rea.*preserva[çc][ãa]o permanente|\\bapp\\b)", names(lista_res))
      if(length(idx_app) > 0) {
        app_conflitos <- Filter(function(x) x$Veredito == "🚨 SOBREPOSIÇÃO", lista_res[idx_app])
        row_app_final <- data.frame(Camada = "Áreas de Preservação Permanente (APPs) - Consolidadas", 
                                    Veredito = ifelse(length(app_conflitos) > 0, "🚨 SOBREPOSIÇÃO", "✅ NADA CONSTA"), 
                                    Detalhes = ifelse(length(app_conflitos) > 0, paste("Interceptou", length(app_conflitos), "tipologia(s) de APP."), "Área livre."), 
                                    stringsAsFactors = FALSE)
        lista_res <- lista_res[-idx_app]
        lista_res[["APPs Consolidadas"]] <- row_app_final
      }
      
      resultados_relatorio(do.call(rbind, lista_res))
      conflitos_geo(geo_full_list)
      
      # --- RENDER TAB 3 MAP (SAFE GROUPING INSTEAD OF BINDING) ---
      output$mapa_sobreposicao <- renderLeaflet({
        ada_tipo <- as.character(sf::st_geometry_type(ada_4326, by_geometry = FALSE))
        m <- leaflet() %>% addProviderTiles(providers$Esri.WorldImagery)
        
        if(isTRUE(any(grepl("POINT", ada_tipo), na.rm = TRUE))) { 
          m <- m %>% addCircleMarkers(data = ada_4326, color = "red", radius = 6, fillOpacity = 0.8, group = "Área de Estudo")
        } else if (isTRUE(any(grepl("LINE", ada_tipo), na.rm = TRUE))) { 
          m <- m %>% addPolylines(data = ada_4326, color = "red", weight = 3, group = "Área de Estudo")
        } else { 
          m <- m %>% addPolygons(data = ada_4326, color = "red", weight = 3, fill = F, group = "Área de Estudo") 
        }
        
        geos <- conflitos_geo()
        nomes_grupos <- c()
        
        if(length(geos) > 0) {
          for(n in names(geos)) {
            if(is.data.frame(geos[[n]]) && nrow(geos[[n]]) > 0) {
              # Safe geometry extraction avoiding corrupt lines
              valid_geom <- geos[[n]][!sf::st_is_empty(geos[[n]]), ]
              
              if(nrow(valid_geom) > 0) {
                # Intelligent group renaming mapping
                group_name <- n
                if(grepl("(?i)enquadramento", n)) group_name <- "Enquadramento de Corpos D'água (Bacias Hidrográficas)"
                if(grepl("(?i)([áa]rea.*preserva[çc][ãa]o permanente|\\bapp\\b)", n)) group_name <- "Áreas de Preservação Permanente (APPs) - Consolidadas"
                
                nomes_grupos <- c(nomes_grupos, group_name)
                tipo <- as.character(sf::st_geometry_type(valid_geom, by_geometry = FALSE))
                
                if(isTRUE(any(grepl("POINT", tipo), na.rm = TRUE))) { 
                  m <- m %>% addCircleMarkers(data = valid_geom, color = "yellow", radius = 7, popup = ~popup_info, group = group_name)
                } else if (isTRUE(any(grepl("LINE", tipo), na.rm = TRUE))) { 
                  m <- m %>% addPolylines(data = valid_geom, color = "yellow", weight = 4, popup = ~popup_info, group = group_name)
                } else { 
                  m <- m %>% addPolygons(data = valid_geom, color = "yellow", weight = 2, fillOpacity = 0.4, popup = ~popup_info, group = group_name) 
                }
              }
            }
          }
          m <- m %>% addLayersControl(overlayGroups = c("Área de Estudo", unique(nomes_grupos)), options = layersControlOptions(collapsed = FALSE))
        } else { 
          m <- m %>% addLayersControl(overlayGroups = c("Área de Estudo"), options = layersControlOptions(collapsed = FALSE)) 
        }
        
        b <- sf::st_bbox(ada_4326)
        if(!is.na(b[["xmin"]])) {
          if(isTRUE(as.numeric(b[["xmin"]]) == as.numeric(b[["xmax"]]))) {
            m <- m %>% setView(lng = as.numeric(b[["xmin"]]), lat = as.numeric(b[["ymin"]]), zoom = 16)
          } else {
            m <- m %>% fitBounds(as.numeric(b[["xmin"]]), as.numeric(b[["ymin"]]), as.numeric(b[["xmax"]]), as.numeric(b[["ymax"]]))
          }
        }
        m
      })
      
      nav_select(id = "nav_tabs", selected = "tab_resultados")
    })
  })
  
