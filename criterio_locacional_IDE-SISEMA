    content = function(file) {
      geos <- conflitos_geo()
      if(length(geos) == 0) { showNotification("Nenhum conflito para exportação.", type = "warning"); return(NULL) }
      temp_dir <- file.path(tempdir(), paste0("export_", as.numeric(Sys.time()))); dir.create(temp_dir, showWarnings = FALSE)
      for(n in names(geos)) { sf::st_write(geos[[n]], dsn = temp_dir, layer = make.names(n), driver = "ESRI Shapefile", delete_layer = TRUE, quiet = TRUE) }
      owd <- setwd(temp_dir); on.exit(setwd(owd))
